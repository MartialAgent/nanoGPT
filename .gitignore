# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*\.class

# IDEs
.DS_Store
.idea
.vscode
.ipynb_checkpoints/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Model Checkpoints and Output
out/
out-*/
*.pt

# Pipeline artifacts — regenerated by prepare.py from input.txt
*.bin
*.pkl

# Note: data/*/input.txt is deliberately tracked, not ignored.
# It is the source text, and regenerating it depends on external URLs that
# may disappear (e.g. karpathy/char-rnn, 2015). The documented measurements
# in docs/study/ are taken against these exact files.

# Logs
*.log
